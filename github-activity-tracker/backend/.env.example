# Database - backend services use ONLY RDS_* variables
# For local Docker setup, point RDS_* to your DB container (e.g. RDS_HOST=db)

RDS_HOST=your-db-host
RDS_PORT=5432
RDS_DATABASE=github_tracker
RDS_USER=postgres
RDS_PASSWORD=your-password

# --------------------------------------------------
# Variables below are ONLY used by the Postgres container
# (Docker setup), NOT by the backend application
# --------------------------------------------------

# POSTGRES_DB=github_data
# POSTGRES_USER=github_user
# POSTGRES_PASSWORD=github_password